# GPU & Execution Mode Configuration
DEVICE=cuda
INFERENCE_MODE=local
MAX_NUM_SAMPLES=5
REQUEST_COOLDOWN_SECONDS=15

# Model & Tokenizer Paths (Relative to PROJECT_ROOT or absolute)
MODEL_PATH=models/e2po/direct_ki_e2po_15k.pt
ESM_MODEL_PATH=models/esm2
TOKENIZER_PATH=models/tokenizer/vocab.json
BERT_CONFIG_PATH=models/bert-base-uncased

# Data & Structure Paths
TARGET_DATA_PATH=data/target_data_eval
STRUCTURE_DATA_PATH=data/structures
DEMO_DATA_PATH=demo_data

# External Tools
VINA_PATH=vina

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Optional natural-language parser. Leave disabled for the built-in rules fallback.
LLM_PROVIDER=none
LLM_API_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=10
